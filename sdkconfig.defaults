# proven Waveshare ESP32-P4-Module-DEV-KIT hardware
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y

# the attached ESP32-P4 is revision v1.3
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# required crypto modules and hardware paths
CONFIG_MBEDTLS_SHA256_C=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_AES_C=y
# CONFIG_MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH is not set
CONFIG_MBEDTLS_GCM_C=y
CONFIG_MBEDTLS_HARDWARE_AES=y
# CONFIG_MBEDTLS_AES_SOFT_FALLBACK is not set
CONFIG_MBEDTLS_HARDWARE_GCM=y
# CONFIG_MBEDTLS_GCM_SUPPORT_NON_AES_CIPHER is not set
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_HARDWARE_ECC=y
# CONFIG_MBEDTLS_ECC_OTHER_CURVES_SOFT_FALLBACK is not set

# credential keys use the general ECC accelerator
# CONFIG_MBEDTLS_HARDWARE_ECDSA_SIGN is not set
# CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY is not set

# keep development logs on the CH343 UART path
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# one FIDO shaped HID interface on the native full speed controller
CONFIG_TINYUSB_DEBUG_LEVEL=0
CONFIG_TINYUSB_MODE_DMA=y
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
CONFIG_TINYUSB_RESUME_CALLBACK=y
CONFIG_TINYUSB_HID_COUNT=1
# CONFIG_TINYUSB_MSC_ENABLED is not set
# CONFIG_TINYUSB_CDC_ENABLED is not set
CONFIG_TINYUSB_MIDI_COUNT=0
CONFIG_TINYUSB_DFU_MODE_NONE=y
# CONFIG_TINYUSB_BTH_ENABLED is not set
CONFIG_TINYUSB_NET_MODE_NONE=y
CONFIG_TINYUSB_VENDOR_COUNT=0

# diagnostic packet exchange stays opt in
# CONFIG_P4KEY_USB_BRINGUP is not set

# stage 01 must stay reversible
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set
